# Also compute Wilson 95% CIs
print("\n\n=== With Wilson 95% CIs ===")
import math

def wilson_ci(p, n, z=1.96):
    if n == 0:
        return (0, 0)
    denom = 1 + z**2 / n
    centre = (p + z**2 / (2*n)) / denom
    halfw = z * math.sqrt(p*(1-p)/n + z**2/(4*n*n)) / denom
    return (max(0, centre - halfw), min(1, centre + halfw))

