print("-" * 100)

for e in d:
    n_param = e['n_param']
    n_ctx = e['n_ctx']
    a_acc = e.get('block_a_acc', 0.0)
    b_acc = e.get('block_b_acc', 0.0)
    all_slot = e.get('all_acc_slot', 0.0)
    joint = e.get('all_acc_joint', 0.0)
    n_samples = e['n_samples']
    sample_corr = e.get('sample_all_correct', 'N/A')
    
    print(f"{n_param:>8} {n_ctx:>6} {a_acc*100:>9.2f}% {b_acc*100:>9.2f}% {all_slot*100:>9.2f}% {joint*100:>9.2f}% {str(sample_corr):>12} {n_samples:>10}")

print("\n\n=== With Wilson 95% CIs (joint) ===")
