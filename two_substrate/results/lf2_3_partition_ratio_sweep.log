import json
import math

def wilson_ci(p, n, z=1.96):
    if n == 0:
        return (0, 0)
    denom = 1 + z**2 / n
    centre = (p + z**2 / (2*n)) / denom
    halfw = z * math.sqrt(p*(1-p)/n + z**2/(4*n*n)) / denom
    return (max(0, centre - halfw), min(1, centre + halfw))

with open('/workspace/FDM_IN_WEIGHTS/split_ratio_sweep_n200/sweep_results.json') as f:
    d = json.load(f)

print(f"Total entries: {len(d)}")
print(f"\nPer-entry available keys:")
for i, e in enumerate(d):
    keys = [k for k in e.keys() if k != 'per_sample_correct']
